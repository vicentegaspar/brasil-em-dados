---
// Home: 4+ KPIs principais em linha, cards com fonte/referência, hero enxuto.
import type { Env, IndicadorExibicao } from "../lib/model";
import { descritorPorId } from "../lib/registro";
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";

export const prerender = false;

const E = env as unknown as Env;

// Os indicadores da home vêm do registro único — mesmos ids de /api/v1/serie.
const IDS_HOME = [
  "bcb-selic",
  "bcb-cambio",
  "bcb-ipca-mensal",
  "sidra-desocupacao",
  "sidra-informalidade",
  "sidra-pib",
  "ons-carga",
] as const;

type Card = {
  nome: string;
  valor: string;
  unidade: string;
  variacaoPct: number | null;
  periodo: string;
  fonte: string;
  fonteUrl: string;
  serie: { valor: number }[];
  disponivel: boolean;
  motivo: string;
};

function paraCard(ind: IndicadorExibicao): Card {
  return {
    nome: ind.nome,
    valor: ind.valorFormatado,
    unidade: ind.unidade,
    variacaoPct: ind.variacaoPct,
    periodo: ind.periodoFormatado,
    fonte: ind.fonte,
    fonteUrl: ind.fonteUrl,
    serie: ind.serie.map((o) => ({ valor: o.valor })),
    disponivel: !ind.indisponivelMotivo,
    motivo: ind.indisponivelMotivo ?? "",
  };
}

let cards: Card[] = [];
let erros: string[] = [];
try {
  const res = await Promise.all(
    IDS_HOME.map((id) => descritorPorId(id)!.coletar(E)),
  );
  for (const ind of res) {
    if (ind.indisponivelMotivo) erros.push(ind.indisponivelMotivo);
    cards.push(paraCard(ind));
  }
  if (cards.every((c) => !c.disponivel)) {
    erros = ["Nenhum indicador pôde ser coletado agora. Tente novamente em instantes."];
  }
} catch (e) {
  console.error(String(e));
  erros = ["Não foi possível carregar os dados agora. Tente novamente em instantes."];
}

function sparkline(pontos: { valor: number }[]): string {
  if (pontos.length < 2) return "";
  const vals = pontos.map((p) => p.valor);
  const min = Math.min(...vals);
  const max = Math.max(...vals);
  const w = 220;
  const h = 48;
  const step = w / (pontos.length - 1);
  const coords = pontos.map((p, i) => {
    const x = i * step;
    const y = h - ((p.valor - min) / (max - min || 1)) * (h - 6) - 3;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const line = `M${coords.join(" L")}`;
  const area = `${line} L${w},${h} L0,${h} Z`;
  return `<svg viewBox="0 0 ${w} ${h}" width="100%" height="${h}" preserveAspectRatio="none" aria-hidden="true">
    <path d="${area}" fill="rgba(0,180,120,0.10)"/>
    <path d="${line}" fill="none" stroke="#00b478" stroke-width="2" stroke-linejoin="round"/>
  </svg>`;
}
---

<Base titulo="Estatísticas do Brasil" paginaAtiva="inicio" descricao="Painel público de estatísticas do Brasil: juros, câmbio, inflação, emprego, PIB, energia, empresas e comparação internacional — dados oficiais do IBGE, BCB, ONS, CVM e World Bank, com fonte, referência e data de coleta.">
  <main class="conteiner">
    <section class="cabecalho">
      <h1 style="font-size:40px">Brasil em dados, com a fonte na mão</h1>
      <p>
        Juros, câmbio, inflação, emprego, PIB e energia — direto das fontes oficiais
        (IBGE, BCB, ONS, CVM, World Bank). Todo número vem com fonte, período de
        referência e data de coleta; fonte fora do ar nunca vira zero.
      </p>
    </section>

    {erros.length > 0 && cards.every((c) => !c.disponivel) && (
      <div class="aviso">{erros.join(" ")}</div>
    )}

    <div class="kpis" style="margin-bottom:32px">
      {cards.map((c) => (
        <article class="kpi">
          <span class="label">{c.nome}</span>
          {c.disponivel ? (
            <>
              <span class="valor">
                {c.valor}
                <span class="unidade">{c.unidade}</span>
              </span>
              {c.variacaoPct != null && (
                <span class={`delta ${c.variacaoPct >= 0 ? "up" : "down"}`}>
                  {c.variacaoPct >= 0 ? "▲" : "▼"} {Math.abs(c.variacaoPct).toLocaleString("pt-BR", { maximumFractionDigits: 2 })}%
                </span>
              )}
              <div set:html={sparkline(c.serie)} />
              <span class="meta">
                Referência: {c.periodo} · Fonte: <a href={c.fonteUrl}>{c.fonte}</a>
              </span>
            </>
          ) : (
            <span class="indisponivel">Indisponível — {c.motivo}</span>
          )}
        </article>
      ))}
    </div>

    <section class="grid">
      <article class="card">
        <h2 class="card-label">Explorar</h2>
        <p style="font-size:14px; margin:0 0 8px">
          <a href="/graficos">Gráficos</a> — compare séries no tempo (ex.: IPCA Brasil x EUA x Japão; Selic e câmbio com filtro de período).
        </p>
        <p style="font-size:14px; margin:0 0 8px">
          <a href="/paises">Países</a> — Brasil x EUA x Japão (+ 8 países) em 6 indicadores de mercado (World Bank).
        </p>
        <p style="font-size:14px; margin:0 0 8px">
          <a href="/estados">Estados</a> — ranking das 27 UFs por PIB, desocupação, informalidade e população (IBGE).
        </p>
        <p style="font-size:14px; margin:0">
          <a href="/empresas">Empresas</a> — balanços de listadas via CVM open data.
        </p>
      </article>
      <article class="card">
        <h2 class="card-label">Scorecards</h2>
        <p style="font-size:14px; margin:0 0 8px">
          <a href="/scorecards">Índices de mercado</a> com definição e fonte explícitas: PIB per
          capita derivado (SIDRA), juros reais (Selic − IPCA 12m) e índice composto de
          "atratividade" com fórmula visível e componentes ligáveis/desligáveis.
        </p>
        <p style="font-size:14px; margin:0">
          <a href="/api/v1/indicadores">API v1</a> — séries em JSON/CSV, sem chave, para reuso.
        </p>
      </article>
    </section>
  </main>
</Base>
