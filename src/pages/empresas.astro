---
// Empresas listadas: DRE consolidada (receita e lucro) do DFP da CVM, dados
// de build (src/data/empresas.json). Compara os dois últimos exercícios
// disponíveis por empresa. Valores em R$ bilhões.
import { getBalancosSeguro, type Balancos } from "../lib/coletores/cvm";
import { formatarBilhoes, formatarNumero } from "../lib/periodos";
import Base from "../layouts/Base.astro";

export const prerender = false;

let balancos: Balancos | null = null;
let erro: string | null = null;
try {
  balancos = await getBalancosSeguro();
  if (!balancos) erro = "Não foi possível carregar os balanços da CVM agora.";
} catch (e) {
  console.error(String(e));
  erro = "Não foi possível carregar os balanços da CVM agora.";
}

type Linha = { ticker: string; nome: string; ano: number; receita: number | null; lucroLiquido: number | null };
const agrupado = new Map<string, Linha[]>();
if (balancos) {
  for (const b of balancos.empresas) {
    const arr = agrupado.get(b.ticker) ?? [];
    arr.push({ ticker: b.ticker, nome: b.nome, ano: b.ano, receita: b.receita, lucroLiquido: b.lucroLiquido });
    agrupado.set(b.ticker, arr);
  }
}
const empresas = [...agrupado.values()].map((l) => l.sort((a, b) => b.ano - a.ano)).sort((a, b) => (b[0].receita ?? 0) - (a[0].receita ?? 0));
const anos = balancos ? [...new Set(balancos.empresas.map((b) => b.ano))].sort((a, b) => b - a) : [];
---

<Base titulo="Empresas listadas" paginaAtiva="empresas" descricao={`DRE consolidada de ${empresas.length} empresas listadas (CVM open data): receita e lucro consolidado por exercício.`}>
  <main class="conteiner">
    <section class="cabecalho">
      <h1>Empresas listadas — {empresas.length} companhias</h1>
      <p>
        Demonstração do Resultado (DRE consolidada) extraída dos arquivos DFP da CVM
        (dados abertos, <a href="https://dados.cvm.gov.br/dados/CIA_ABERTA/DOC/DFP/Dados/">dados.cvm.gov.br</a>).
        Comparação dos últimos dois exercícios fechados ({anos.join(" e ") || "—"}).
        Lucro = "Lucro/Prejuízo Consolidado do Período" (conta 3.11 do DRE; 3.09 no
        layout de bancos — ex. Itaú, Bradesco, BB).
      </p>
    </section>

    {erro && <div class="aviso">{erro}</div>}

    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
      {empresas.map((l) => (
        <article class="card">
          <h2 class="card-label">{l[0].nome}</h2>
          <table class="tabela" style="font-size:13px">
            <thead>
              <tr>
                <th data-ordenavel="false">Exercício</th>
                <th class="num" data-ordenavel="false">Receita (R$ bi)</th>
                <th class="num" data-ordenavel="false">Lucro (R$ bi)</th>
                <th class="num" data-ordenavel="false" title="Lucro ÷ Receita">Margem</th>
              </tr>
            </thead>
            <tbody>
              {l.map((x) => (
                <tr>
                  <td>{x.ano}</td>
                  <td class="num">{x.receita != null ? formatarBilhoes(x.receita) : "—"}</td>
                  <td class="num">{x.lucroLiquido != null ? formatarBilhoes(x.lucroLiquido) : "—"}</td>
                  <td class="num">{x.receita && x.lucroLiquido != null ? formatarNumero((x.lucroLiquido / x.receita) * 100, 1) + "%" : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="fonte-ref" style="margin-top:8px">
            {balancos?.exercicioFonte} · CVM open data · números-síntese redistribuídos com citação
          </p>
        </article>
      ))}
    </div>
  </main>
</Base>
